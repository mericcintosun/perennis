# Perennis environment.
#
# Every variable below is optional. With none of them set the console runs on the
# fixtures in fixtures/*.json and every screen still works, which is what you
# want while building the UI. Fill them in to point the same screens at Shannon.
#
# Copy this file to .env.local before editing.

# Which data source every screen and API route reads through. Two accepted
# values: "fake" (fixtures, no RPC) and "real" (chain reads via lib/dreamdex.ts).
# Anything else is treated as fake. Read by lib/adapters/index.ts. Setting this
# to real without NEXT_PUBLIC_CONTRACT_ADDRESS falls back to fixtures and says so
# in the console badge.
ADAPTER_MODE=fake

# Somnia Shannon testnet chain id. Read by lib/dreamdex.ts.
# Leave as is unless Somnia changes it: https://docs.somnia.network/developer
NEXT_PUBLIC_CHAIN_ID=50312

# Shannon JSON-RPC endpoint. Read by lib/dreamdex.ts.
NEXT_PUBLIC_SOMNIA_RPC_URL=https://dream-rpc.somnia.network

# Block explorer, used to link every roll transaction from the ledger.
NEXT_PUBLIC_EXPLORER_URL=https://shannon-explorer.somnia.network

# Your deployed PerennisVault. Get it from the address printed by
# `forge script script/Deploy.s.sol` (see contracts/README.md).
# When empty, lib/dreamdex.ts fetchVaults() returns seed vaults instead.
NEXT_PUBLIC_CONTRACT_ADDRESS=

# DreamDEX BinaryMarketsModule on Shannon. Take it from
# https://docs.dreamdex.io/developers/event-contracts (contracts and addresses).
# When empty, lib/dreamdex.ts fetchEventWindows() returns seed windows instead.
NEXT_PUBLIC_BINARY_MARKETS_MODULE=

# Collateral token. On Shannon this is tUSDC, which has a public faucet(uint256).
# Decimals are read from the contract, never assumed.
NEXT_PUBLIC_COLLATERAL_TOKEN=0x70a86D8842FB63C4Ad2b7cdddF530eBf1BB25d8E

# --- contract deploy only, never read by the frontend ---
# Used by contracts/script/Deploy.s.sol and by forge on the command line.
# COLLATERAL_TOKEN=0x70a86D8842FB63C4Ad2b7cdddF530eBf1BB25d8E
# BINARY_MARKETS_MODULE=
# RPC_URL=https://dream-rpc.somnia.network
# Deployer key for the testnet only. Never a key that holds real funds.
# FARM_EVM_PRIVATE_KEY=
