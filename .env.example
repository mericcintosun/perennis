# Perennis environment.
#
# Every variable below is optional. With none of them set the console runs on the
# fixtures in fixtures/*.json and every screen still works, which is what you
# want while building the UI. Fill them in to point the same screens at Shannon.
#
# Copy this file to .env.local before editing.
#
# Only two files in this repo read process.env: lib/config.ts holds everything
# below, and lib/adapters/index.ts reads ADAPTER_MODE. Nothing else does.

# Which data source every screen and API route reads through. Two accepted
# values: "fake" (fixtures, no RPC) and "real" (chain reads via lib/dreamdex.ts).
# Anything else is treated as fake. Read by lib/adapters/index.ts. Setting this
# to real without NEXT_PUBLIC_CONTRACT_ADDRESS falls back to fixtures and says so
# in the console badge. Source: you decide, per deployment.
ADAPTER_MODE=fake

# Somnia Shannon testnet chain id. Read by lib/config.ts as CHAIN_ID.
# Source: https://docs.somnia.network/developer. Leave as is unless Somnia
# changes it.
NEXT_PUBLIC_CHAIN_ID=50312

# Shannon JSON-RPC endpoint. Read by lib/config.ts as RPC_URL.
# Source: the Somnia developer docs. Public endpoint, no API key, so it is safe
# under a NEXT_PUBLIC_ prefix. If you swap in a keyed provider, move it to a
# server only key first.
NEXT_PUBLIC_SOMNIA_RPC_URL=https://dream-rpc.somnia.network

# Block explorer base, used to link every roll transaction from the ledger.
# Read by lib/config.ts as EXPLORER_URL. Source: the Somnia developer docs.
NEXT_PUBLIC_EXPLORER_URL=https://shannon-explorer.somnia.network

# Your deployed PerennisVault. Read by lib/config.ts as VAULT_ADDRESS.
# Source: the address printed by `forge script script/Deploy.s.sol`
# (see contracts/README.md). When empty, lib/dreamdex.ts returns seed vaults and
# a seed ledger instead, with the reason in the console badge.
NEXT_PUBLIC_CONTRACT_ADDRESS=

# DreamDEX BinaryMarketsModule on Shannon. Read by lib/config.ts as
# BINARY_MARKETS_MODULE. Source:
# https://docs.dreamdex.io/developers/event-contracts (contracts and addresses).
# When empty, lib/dreamdex.ts fetchEventWindows() returns seed windows instead.
NEXT_PUBLIC_BINARY_MARKETS_MODULE=

# Collateral token. On Shannon this is tUSDC, which has a public faucet(uint256).
# Read by lib/config.ts as COLLATERAL_TOKEN. Source: the DreamDEX contracts and
# addresses page. Decimals are read from the contract, never assumed.
NEXT_PUBLIC_COLLATERAL_TOKEN=0x70a86D8842FB63C4Ad2b7cdddF530eBf1BB25d8E

# The Somnia reactivity precompile is fixed by the protocol at
# 0x0000000000000000000000000000000000000100, so it is a constant in
# lib/config.ts (REACTIVITY_PRECOMPILE) and not an env key. The same address is
# hardcoded in contracts/src/PerennisVault.sol.

# --- contract deploy only, never read by the frontend ---
# Used by contracts/script/Deploy.s.sol and by forge on the command line. No file
# under app/, components/ or lib/ reads any of these.
# COLLATERAL_TOKEN=0x70a86D8842FB63C4Ad2b7cdddF530eBf1BB25d8E
# BINARY_MARKETS_MODULE=
# RPC_URL=https://dream-rpc.somnia.network
# Deployer key for the testnet only. Never a key that holds real funds, and never
# read by the frontend: it exists for forge and nothing else.
# FARM_EVM_PRIVATE_KEY=
